# Copy this file to .env.n8n and fill your real values.

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Replace with a strong random secret.
N8N_ENCRYPTION_KEY=replace-with-random-secret

# Optional basic auth for local protection.
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=replace-with-strong-password

# Optional timezone.
GENERIC_TIMEZONE=America/Chicago
